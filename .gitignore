# Transient artifacts of running the suite and the installer in-place.
# The emitted .claude/.gitignore covers INSTALLED projects; this file covers
# this repository, which is the installer's source, not an installed project.
__pycache__/
*.pyc

# Hook-execution log: the suite invokes emitted hooks, which append here.
.claude/logs/

# Session checkpoints are local working notes, not release artifacts.
.claude/checkpoints/

# Session plans are working documents (.claude/readiness-runbook.md:101).
# They were tracked ONCE, by a `git add -A` in a correction commit, and that
# turned test_doc_citations red. A rule nothing enforces is a rule that gets
# broken; this is the enforcement.
.claude/sessions/

# The mutation gate keeps no state here any more: it measures in a private
# `git worktree` under the system temp dir, which it deletes when it finishes.
# The directory is left ignored so an old backup from before 2026-09-09 cannot
# be committed by accident.
.claude/mutation-gate-backups/

# The operator-attention alarm's PID file. It is runtime state, not source, and
# it lives beside the harness. Without this line the alarm being UP makes the
# mutation gate refuse every invocation (GUARD 1 wants a clean tree), and the
# alarm starting mid-run scores every row INTERFERED -- two features on this
# same branch disabling each other. Measured: 5/5 rows INTERFERED, rc 1.
.claude/.alert-operator.pid

# Editor/OS debris beside a mutation set. Without these the gate refuses to run
# (GUARD 1 wants a clean tree) exactly while a set is open in an editor.
*.swp
*.swo
*~
.DS_Store
